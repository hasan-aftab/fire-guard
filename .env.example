APP_NAME="FireTrack PNG"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Pacific/Port_Moresby

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FIRE_TRACKER_DISK=local
REPORT_DISK=
LARAVEL_PDF_DRIVER=dompdf
REPORT_COMPANY_NAME="Fire Tracker"
REPORT_COMPANY_PHONE=
REPORT_COMPANY_EMAIL=
REPORT_LOGO_DISK=local
REPORT_LOGO_PATH=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# One-word mode switch — MAIL_MAILER selects everything
# smtp -local Mailpit (MAIL_HOST/MAIL_PORT above)
# brevo - Brevo transactional API
# MAIL_FROM_ADDRESS must be a verified sender in Brevo
MAIL_MAILER=brevo
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_TIMEOUT=30
MAIL_REQUIRE_TLS=false
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="firetracker@local.test"
MAIL_FROM_NAME="Fire Tracker"
# Local Mailpit only. Production Brevo uses the transactional API, not SMTP:
# MAIL_MAILER=brevo and BREVO_API_KEY=<Brevo API key from Settings > SMTP & API>.
# The sender in MAIL_FROM_ADDRESS must be verified in Brevo (Settings > Senders).
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# For S3-compatible providers, set the endpoint and optional URL.
# AWS_ENDPOINT=
# AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Meta WhatsApp Cloud API. Sender access tokens are entered per account in the admin UI.
WHATSAPP_GRAPH_VERSION=v25.0
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
